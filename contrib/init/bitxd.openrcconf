# /etc/conf.d/bitxd: config file for /etc/init.d/bitxd

# Config file location
#BITXD_CONFIGFILE="/etc/bitx/bitx.conf"

# What directory to write pidfile to?  (created and owned by $BITXD_USER)
#BITXD_PIDDIR="/var/run/bitxd"

# What filename to give the pidfile
#BITXD_PIDFILE="${BITXD_PIDDIR}/bitxd.pid"

# Where to write bitxd data (be mindful that the blockchain is large)
#BITXD_DATADIR="/var/lib/bitxd"

# User and group to own bitxd process
#BITXD_USER="bitx"
#BITXD_GROUP="bitx"

# Path to bitxd executable
#BITXD_BIN="/usr/bin/bitxd"

# Nice value to run bitxd under
#BITXD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#BITXD_OPTS=""

# The timeout in seconds OpenRC will wait for bitxd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
BITXD_SIGTERM_TIMEOUT=600
