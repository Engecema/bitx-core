#!/sbin/openrc-run

# backward compatibility for existing gentoo layout
#
if [ -d "/var/lib/bitx/.bitx" ]; then
	BITXD_DEFAULT_DATADIR="/var/lib/bitx/.bitx"
else
	BITXD_DEFAULT_DATADIR="/var/lib/bitxd"
fi

BITXD_CONFIGFILE=${BITXD_CONFIGFILE:-/etc/bitx/bitx.conf}
BITXD_PIDDIR=${BITXD_PIDDIR:-/var/run/bitxd}
BITXD_PIDFILE=${BITXD_PIDFILE:-${BITXD_PIDDIR}/bitxd.pid}
BITXD_DATADIR=${BITXD_DATADIR:-${BITXD_DEFAULT_DATADIR}}
BITXD_USER=${BITXD_USER:-${BITX_USER:-bitx}}
BITXD_GROUP=${BITXD_GROUP:-bitx}
BITXD_BIN=${BITXD_BIN:-/usr/bin/bitxd}
BITXD_NICE=${BITXD_NICE:-${NICELEVEL:-0}}
BITXD_OPTS="${BITXD_OPTS:-${BITX_OPTS}}"

name="BitX Core Daemon"
description="BitX cryptocurrency P2P network daemon"

command="${BITXD_BIN}"
command_args="-pid=\"${BITXD_PIDFILE}\" \
		-conf=\"${BITXD_CONFIGFILE}\" \
		-datadir=\"${BITXD_DATADIR}\" \
		-daemon \
		${BITXD_OPTS}"

required_files="${BITXD_CONFIGFILE}"
start_stop_daemon_args="-u ${BITXD_USER} \
			-g ${BITXD_GROUP} \
			-N ${BITXD_NICE} -w 2000"
pidfile="${BITXD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${BITXD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${BITXD_USER}:${BITXD_GROUP}" \
	"${BITXD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${BITXD_USER}:${BITXD_GROUP}" \
	"${BITXD_PIDDIR}"

	checkpath -f \
	-o "${BITXD_USER}:${BITXD_GROUP}" \
	-m 0660 \
	"${BITXD_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if grep -qs '^rpcuser=' "${BITXD_CONFIGFILE}" && \
		! grep -qs '^rpcpassword=' "${BITXD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run bitxd."
		eerror "The setting must appear in ${BITXD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"BitX Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
